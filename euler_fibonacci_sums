# The logic for solving the 1001x1001 spiral diagonal sum
# Sum = 1 + sum of corners for each layer
# Corner values for side length n: 
# n^2, n^2 - (n-1), n^2 - 2(n-1), n^2 - 3(n-1)
# Simplified: 4n^2 - 6n + 6

def spiral_diagonal_sum(size):
    total_sum = 1
    # We step by 2 to hit only odd side lengths (3, 5, 7...)
    for n in range(3, size + 1, 2):
        total_sum += (4 * n**2 - 6 * n + 6)
    return total_sum

result = spiral_diagonal_sum(1001)
print(f"The sum of the diagonals for a 1001x1001 spiral is: {result}")