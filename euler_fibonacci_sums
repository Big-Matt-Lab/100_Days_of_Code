import time

# Use a dictionary as our "flight data recorder"
memo = {1: 1}

def get_collatz_length(n):
    # If we've seen this number, return the stored length immediately
    if n in memo:
        return memo[n]
    
    # Otherwise, calculate it and store it
    if n % 2 == 0:
        length = 1 + get_collatz_length(n // 2)
    else:
        length = 1 + get_collatz_length(3 * n + 1)
        
    memo[n] = length
    return length

start_time = time.perf_counter()

max_chain = 0
starting_num = 0

# Check every number up to 1,000,000
for i in range(1, 1000001):
    length = get_collatz_length(i)
    if length > max_chain:
        max_chain = length
        starting_num = i

end_time = time.perf_counter()

print(f"The number with the longest chain is {starting_num}")
print(f"Time taken: {end_time - start_time:.6f} seconds")